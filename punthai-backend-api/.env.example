DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=punthai_db
DB_PORT=3306
DB_SSL=false

GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=

OMISE_PUBLIC_KEY=pkey_test_xxx
OMISE_SECRET_KEY=skey_test_xxx

FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

PORT=3000

# ---- Cloudflare R2 object storage (for user uploads + AI-generated images) ----
# Leave BLANK to fall back to local disk (uploads/). Set all 5 to enable R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=punthai-uploads
# Public URL of the bucket (R2.dev dev URL or your custom domain), no trailing slash
R2_PUBLIC_URL=
